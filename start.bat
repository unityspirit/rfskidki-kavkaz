@echo off
chcp 65001 > nul
title ХабСкидок.рф - Сервер скидок по QR-кодам
echo ========================================================================
echo  🚀 Запуск Хаба Скидок и Бонусов по QR-кодам (ХабСкидок.рф)
echo ========================================================================
echo.
echo Проверка Node.js...
node -v > nul 2>&1
if %errorlevel% neq 0 (
    echo [ОШИБКА] Node.js не найден! Пожалуйста, установите Node.js с официального сайта: https://nodejs.org
    pause
    exit /b 1
)

echo Сервер запускается на http://localhost:3000 ...
echo Клиентский сайт с картой: http://localhost:3000
echo Панель управления (Админка): http://localhost:3000/admin.html
echo.
echo Для остановки сервера нажмите Ctrl + C
echo ========================================================================
echo.

node server.js
pause
